    <!-- Onboarding -->
    <string name="onboarding_welcome_title">به سینا فایننس خوش آمدید</string>
    <string name="onboarding_welcome_desc">مدیریت مالی شخصی لوکس، امن و هوشمند شما. کنترل کامل درآمدها و هزینه‌های خود را در دست بگیرید.</string>
    <string name="onboarding_lang_title">انتخاب زبان</string>
    <string name="onboarding_country_title">انتخاب کشور</string>
    <string name="onboarding_currency_title">تأیید واحد پولی</string>
    <string name="onboarding_currency_note">زبان و واحد پول به‌صورت خودکار هماهنگ هستند. شما می‌توانید در هر زمان پروفایل مالی خود را بدون از دست دادن اطلاعات تغییر دهید.</string>
    <string name="onboarding_privacy_title">حریم خصوصی شما اولویت ماست</string>
    <string name="onboarding_privacy_desc">سینا فایننس کاملاً آفلاین‌محور است. داده‌های مالی شما به صورت امن روی دستگاه ذخیره می‌شود. بدون ردیابی و بدون ارسال پیامک‌ها به سرور.</string>
    <string name="onboarding_google_title">پشتیبان‌گیری ابری (اختیاری)</string>
    <string name="onboarding_google_desc">برای ذخیره و بازیابی امن داده‌های مالی خود به حساب گوگل متصل شوید.</string>
    <string name="onboarding_sms_title">تشخیص پیامک بانکی (اختیاری)</string>
    <string name="onboarding_sms_desc">تشخیص خودکار پیامک‌های واریز و برداشت بانکی. پیامک‌ها فقط روی گوشی شما تحلیل می‌شوند و رمزهای پویا هرگز ذخیره نمی‌شوند.</string>
